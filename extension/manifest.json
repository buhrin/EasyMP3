{
  "manifest_version": 3,
  "name": "EasyMP3",
  "version": "1.1.0",
  "description": "Send YouTube videos to EasyMP3 and redirect Shazam songs to YouTube.",
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*", "https://www.shazam.com/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EasyMP3",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "web_accessible_resources": [{
    "resources": ["icons/icon-32.png"],
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"]
  }],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
      "js": ["youtube-state.js", "youtube.js"],
      "css": ["youtube.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.shazam.com/*"],
      "js": ["shazam-logic.js", "shazam.js"],
      "run_at": "document_idle"
    }
  ]
}
